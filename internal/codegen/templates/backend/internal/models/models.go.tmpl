package models

import "gorm.io/gorm"

{{- if .MainHasStatus}}
const StatusNew = {{printf "%q" .StatusNew}}
{{- end}}

type User struct {
	gorm.Model
	FullName     string `json:"full_name"`
	Phone        string `json:"phone"`
	Email        string `json:"email"`
	Login        string `json:"login" gorm:"uniqueIndex"`
	PasswordHash string `json:"-"`
	IsAdmin      bool   `json:"is_admin"`
}

type {{.Main.Code}} struct {
	gorm.Model
	UserID uint `json:"user_id"`
	User   User `json:"user,omitempty"`
{{- range .Main.Fields}}
	{{.GoName}} {{.GoType}} `json:"{{.Column}}"`
{{- end}}
{{- if .MainHasStatus}}
	Status string `json:"status"`
{{- end}}
{{- if .Reviews}}
	Review *Review `json:"review,omitempty" gorm:"foreignKey:RecordID;references:ID"`
{{- end}}
}

{{- if .Reviews}}
type Review struct {
	gorm.Model
	UserID   uint   `json:"user_id"`
	RecordID uint   `json:"record_id" gorm:"uniqueIndex"`
	Text     string `json:"text"`
	Rating   int    `json:"rating"`
}
{{- end}}
