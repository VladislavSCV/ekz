package seed

import (
	"golang.org/x/crypto/bcrypt"
	"gorm.io/gorm"

	"{{.ProjectSlug}}/backend/internal/models"
)

const (
	adminLogin    = "Admin26"
	adminPassword = "Demo20"
)

func Run(db *gorm.DB) error {
	var count int64
	if err := db.Model(&models.User{}).Where("login = ?", adminLogin).Count(&count).Error; err != nil {
		return err
	}
	if count > 0 {
		return nil
	}
	hash, err := bcrypt.GenerateFromPassword([]byte(adminPassword), bcrypt.DefaultCost)
	if err != nil {
		return err
	}
	admin := models.User{
		FullName:     "Администратор",
		Phone:        "+70000000000",
		Email:        "admin@conferences.local",
		Login:        adminLogin,
		PasswordHash: string(hash),
		IsAdmin:      true,
	}
	return db.Create(&admin).Error
}
