var dateRe = regexp.MustCompile(`^(0[1-9]|[12][0-9]|3[01])\.(0[1-9]|1[0-2])\.(20[0-9]{2})$`)

func (h *Handlers) Register(c *fiber.Ctx) error {
	var req struct {
		FullName string `json:"full_name"`
		Phone    string `json:"phone"`
		Email    string `json:"email"`
		Login    string `json:"login"`
		Password string `json:"password"`
	}
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "неверный формат данных"})
	}
	req.Login = strings.TrimSpace(req.Login)
	if strings.TrimSpace(req.FullName) == "" || strings.TrimSpace(req.Phone) == "" ||
		strings.TrimSpace(req.Email) == "" || req.Login == "" || req.Password == "" {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "заполните все поля"})
	}
	if err := auth.ValidateLogin(req.Login); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
	}
	if err := auth.ValidatePassword(req.Password); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
	}
	var exists int64
	h.DB.Model(&models.User{}).Where("login = ?", req.Login).Count(&exists)
	if exists > 0 {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "логин уже занят"})
	}
	hash, err := auth.HashPassword(req.Password)
	if err != nil {
		return err
	}
	user := models.User{
		FullName:     strings.TrimSpace(req.FullName),
		Phone:        strings.TrimSpace(req.Phone),
		Email:        strings.TrimSpace(req.Email),
		Login:        req.Login,
		PasswordHash: hash,
	}
	if err := h.DB.Create(&user).Error; err != nil {
		return err
	}
	return c.JSON(fiber.Map{
		"message": "регистрация успешна",
		"token":   strconv.FormatUint(uint64(user.ID), 10),
		"user":    publicUser(user),
	})
}

func (h *Handlers) Login(c *fiber.Ctx) error {
	var req struct {
		Login    string `json:"login"`
		Password string `json:"password"`
	}
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "неверный формат данных"})
	}
	var user models.User
	if err := h.DB.Where("login = ?", strings.TrimSpace(req.Login)).First(&user).Error; err != nil {
		return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"error": "неверный логин или пароль"})
	}
	if !auth.CheckPassword(user.PasswordHash, req.Password) {
		return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"error": "неверный логин или пароль"})
	}
	return c.JSON(fiber.Map{
		"token": strconv.FormatUint(uint64(user.ID), 10),
		"user":  publicUser(user),
	})
}

func (h *Handlers) Me(c *fiber.Ctx) error {
	u, _ := middleware.User(c)
	return c.JSON(publicUser(u))
}

func (h *Handlers) CreateBooking(c *fiber.Ctx) error {
	u, _ := middleware.User(c)
	var req struct {
		RoomType      string `json:"room_type"`
		StartDate     string `json:"start_date"`
		PaymentMethod string `json:"payment_method"`
	}
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "неверный формат данных"})
	}
	allowedRooms := map[string]bool{
{{- range .Theme.Options}}
		"{{.Value}}": true,
{{- end}}
	}
	allowedPay := map[string]bool{
{{- range .Theme.Payments}}
		"{{.Value}}": true,
{{- end}}
	}
	if !allowedRooms[req.RoomType] {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "выберите «{{.Theme.Labels.OptionField}}» из списка"})
	}
	if !allowedPay[req.PaymentMethod] {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "выберите способ оплаты из списка"})
	}
	if !dateRe.MatchString(strings.TrimSpace(req.StartDate)) {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "дата в формате ДД.ММ.ГГГГ"})
	}
	if _, err := time.Parse("02.01.2006", req.StartDate); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "некорректная дата"})
	}
	b := models.Booking{
		UserID:        u.ID,
		RoomType:      req.RoomType,
		StartDate:     req.StartDate,
		PaymentMethod: req.PaymentMethod,
		Status:        models.StatusNew,
	}
	if err := h.DB.Create(&b).Error; err != nil {
		return err
	}
	return c.Status(fiber.StatusCreated).JSON(b)
}

func (h *Handlers) MyBookings(c *fiber.Ctx) error {
	u, _ := middleware.User(c)
	var list []models.Booking
	if err := h.DB.Preload("Review").Where("user_id = ?", u.ID).Order("id desc").Find(&list).Error; err != nil {
		return err
	}
	return c.JSON(list)
}

func (h *Handlers) CreateReview(c *fiber.Ctx) error {
	u, _ := middleware.User(c)
	var req struct {
		BookingID uint   `json:"booking_id"`
		Text      string `json:"text"`
		Rating    int    `json:"rating"`
	}
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "неверный формат данных"})
	}
	if strings.TrimSpace(req.Text) == "" || req.Rating < 1 || req.Rating > 5 {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "укажите текст и оценку от 1 до 5"})
	}
	var booking models.Booking
	if err := h.DB.First(&booking, req.BookingID).Error; err != nil || booking.UserID != u.ID {
		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": "заявка не найдена"})
	}
	if booking.Status == models.StatusNew {
		return c.Status(fiber.StatusForbidden).JSON(fiber.Map{"error": "отзыв доступен после смены статуса администратором"})
	}
	var existing int64
	h.DB.Model(&models.Review{}).Where("booking_id = ?", booking.ID).Count(&existing)
	if existing > 0 {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "отзыв уже оставлен"})
	}
	rev := models.Review{
		UserID:    u.ID,
		BookingID: booking.ID,
		Text:      strings.TrimSpace(req.Text),
		Rating:    req.Rating,
	}
	if err := h.DB.Create(&rev).Error; err != nil {
		return err
	}
	return c.Status(fiber.StatusCreated).JSON(rev)
}

func (h *Handlers) AdminBookings(c *fiber.Ctx) error {
	page, _ := strconv.Atoi(c.Query("page", "1"))
	limit, _ := strconv.Atoi(c.Query("limit", "5"))
	if page < 1 {
		page = 1
	}
	if limit < 1 || limit > 50 {
		limit = 5
	}
	status := c.Query("status")
	sortBy := c.Query("sort", "id")
	sortDir := strings.ToUpper(c.Query("dir", "DESC"))
	if sortDir != "ASC" && sortDir != "DESC" {
		sortDir = "DESC"
	}
	allowedSort := map[string]bool{"id": true, "start_date": true, "status": true, "room_type": true}
	if !allowedSort[sortBy] {
		sortBy = "id"
	}

	q := h.DB.Model(&models.Booking{}).Preload("User")
	if status != "" && status != "all" {
		q = q.Where("status = ?", status)
	}
	var total int64
	q.Count(&total)

	var list []models.Booking
	offset := (page - 1) * limit
	if err := q.Order(sortBy + " " + sortDir).Offset(offset).Limit(limit).Find(&list).Error; err != nil {
		return err
	}
	return c.JSON(fiber.Map{
		"items": list,
		"total": total,
		"page":  page,
		"limit": limit,
		"pages": (total + int64(limit) - 1) / int64(limit),
	})
}

func (h *Handlers) UpdateBookingStatus(c *fiber.Ctx) error {
	id, err := strconv.Atoi(c.Params("id"))
	if err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "неверный id"})
	}
	var req struct {
		Status string `json:"status"`
	}
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "неверный формат"})
	}
	allowed := map[string]bool{
		models.StatusAssigned:  true,
		models.StatusCompleted: true,
		models.StatusNew:       true,
	}
	if !allowed[req.Status] {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "недопустимый статус"})
	}
	var booking models.Booking
	if err := h.DB.First(&booking, id).Error; err != nil {
		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": "заявка не найдена"})
	}
	booking.Status = req.Status
	if err := h.DB.Save(&booking).Error; err != nil {
		return err
	}
	return c.JSON(fiber.Map{"message": "статус обновлён", "booking": booking})
}

func publicUser(u models.User) fiber.Map {
	return fiber.Map{
		"id":        u.ID,
		"full_name": u.FullName,
		"login":     u.Login,
		"email":     u.Email,
		"is_admin":  u.IsAdmin,
	}
}
