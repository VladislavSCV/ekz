<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>{{.Theme.Name}} — {{.Theme.Labels.BookingSingular}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles.css" />
  </head>
  <body>
    <div class="app-shell">
      <header class="brand-header">
        <h1>Оформление {{.Theme.Labels.BookingSingular | lower}}</h1>
        <p>{{.Theme.Tagline}}</p>
      </header>
      <div class="card-panel">
        <div id="booking-alert" class="alert alert-inline d-none"></div>
        <form id="booking-form">
          <div class="mb-3">
            <label class="form-label">{{.Theme.Labels.OptionField}}</label>
            <select class="form-select" name="room_type" required>
              <option value="">Выберите...</option>
{{- range .Theme.Options}}
              <option value="{{.Value}}">{{.Label}}</option>
{{- end}}
            </select>
            <div id="room_type-hint" class="form-hint"></div>
          </div>
          <div class="mb-3">
            <label class="form-label">{{.Theme.Labels.DateField}} (ДД.ММ.ГГГГ)</label>
            <input class="form-control" name="start_date" placeholder="{{.Theme.Labels.DatePlaceholder}}" pattern="\d{2}\.\d{2}\.\d{4}" required />
            <div id="start_date-hint" class="form-hint"></div>
          </div>
          <div class="mb-3">
            <label class="form-label">{{.Theme.Labels.PaymentField}}</label>
            <select class="form-select" name="payment_method" required>
              <option value="">Выберите...</option>
{{- range .Theme.Payments}}
              <option value="{{.Value}}">{{.Label}}</option>
{{- end}}
            </select>
            <div id="payment_method-hint" class="form-hint"></div>
          </div>
          <button type="submit" class="btn btn-brand w-100">Отправить заявку</button>
        </form>
        <a class="nav-link-soft" href="/cabinet.html">Личный кабинет</a>
      </div>
    </div>
    <script type="module" src="/src/pages/booking.js"></script>
  </body>
</html>
