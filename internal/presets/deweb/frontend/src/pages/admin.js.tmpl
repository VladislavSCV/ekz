import { api, clearSession, getUser, requireAuth } from '../api.js'
import { ADMIN_STATUS_OPTIONS } from '../theme-config.js'

if (!requireAuth()) throw new Error('auth')
const user = getUser()
if (!user?.is_admin) {
  window.location.href = '/cabinet.html'
  throw new Error('redirect')
}

document.getElementById('logout-btn').addEventListener('click', () => {
  clearSession()
  window.location.href = '/index.html'
})

const tableEl = document.getElementById('admin-table')
const paginationEl = document.getElementById('pagination')
const toastEl = document.getElementById('status-toast')
const toast = bootstrap.Toast.getOrCreateInstance(toastEl)

let state = { page: 1, limit: 5 }

async function load() {
  const status = document.getElementById('filter-status').value
  const sort = document.getElementById('sort-field').value
  const dir = document.getElementById('sort-desc').checked ? 'DESC' : 'ASC'
  const q = new URLSearchParams({ page: state.page, limit: state.limit, status, sort, dir })
  const data = await api(`/admin/bookings?${q}`)
  renderTable(data.items)
  renderPagination(data.page, data.pages)
}

function statusOptions(selected) {
  return ADMIN_STATUS_OPTIONS.map(
    (s) => `<option value="${s}" ${s === selected ? 'selected' : ''}>${s}</option>`
  ).join('')
}

function renderTable(items) {
  if (!items.length) {
    tableEl.innerHTML = '<p class="text-muted small">Нет заявок</p>'
    return
  }
  tableEl.innerHTML = `<table class="table table-sm table-striped align-middle mb-0">
    <thead><tr>
      <th>ID</th><th>Пользователь</th><th>Услуга</th><th>Дата</th><th>Статус</th><th></th>
    </tr></thead>
    <tbody>${items
      .map(
        (b) => `<tr>
        <td>${b.ID}</td>
        <td>${b.User?.full_name || '—'}<br><span class="text-muted">${b.User?.login || ''}</span></td>
        <td>${b.room_type}</td>
        <td>${b.start_date}</td>
        <td><span class="status-badge">${b.status}</span></td>
        <td>
          <select class="form-select form-select-sm status-select" data-id="${b.ID}">
            ${statusOptions(b.status)}
          </select>
        </td>
      </tr>`
      )
      .join('')}</tbody></table>`

  tableEl.querySelectorAll('.status-select').forEach((sel) => {
    sel.addEventListener('change', async () => {
      try {
        await api(`/admin/bookings/${sel.dataset.id}/status`, {
          method: 'PATCH',
          body: JSON.stringify({ status: sel.value }),
        })
        toast.show()
        await load()
      } catch (err) {
        alert(err.message)
      }
    })
  })
}

function renderPagination(page, pages) {
  if (pages <= 1) {
    paginationEl.innerHTML = ''
    return
  }
  let html = ''
  for (let p = 1; p <= pages; p++) {
    html += `<li class="page-item ${p === page ? 'active' : ''}">
      <a class="page-link" href="#" data-page="${p}">${p}</a></li>`
  }
  paginationEl.innerHTML = html
  paginationEl.querySelectorAll('[data-page]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault()
      state.page = Number(a.dataset.page)
      load()
    })
  })
}

;['filter-status', 'sort-field', 'sort-desc'].forEach((id) => {
  document.getElementById(id).addEventListener('change', () => {
    state.page = 1
    load()
  })
})

load().catch((err) => {
  tableEl.innerHTML = `<p class="text-danger small">${err.message}</p>`
})
